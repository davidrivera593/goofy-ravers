rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() {
      return isAuth() && getUserRole() == 'admin';
    }
    function isMod() {
      return isAuth() && (getUserRole() == 'moderator' || getUserRole() == 'admin');
    }

    // ── Users ─────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if true;
      allow create: if isOwner(uid);
      // Owners can update their own doc but CANNOT change their own role or
      // banned fields. Mods/admins may additionally revoke (or grant) another
      // user's organizer badge — and ONLY that field — to shut down
      // impersonation. The organizer badge is a soft, self-serve identity
      // signal and grants no permissions.
      allow update: if
        (isOwner(uid)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'banned']))
        || (isMod()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isOrganizer']));
    }

    // A likes/going toggle may only add or remove the caller's own uid
    function togglesOnlySelf(field) {
      let before = resource.data.get(field, []).toSet();
      let after = request.resource.data.get(field, []).toSet();
      return (after.difference(before) == [request.auth.uid].toSet()
              && before.difference(after).size() == 0)
          || (before.difference(after) == [request.auth.uid].toSet()
              && after.difference(before).size() == 0);
    }
    // Comment counter may only move by one per write
    function commentCountDeltaOk() {
      let before = resource.data.get('commentCount', 0);
      let after = request.resource.data.get('commentCount', 0);
      return after == before + 1 || after == before - 1;
    }
    // Any signed-in user may touch ONLY the interaction fields
    // (likes, RSVP, comment counter) on someone else's post — and only
    // in ways that affect themselves.
    function isInteractionUpdate() {
      let keys = request.resource.data.diff(resource.data).affectedKeys();
      return keys.hasOnly(['likes', 'going', 'commentCount'])
        && (!keys.hasAny(['likes']) || togglesOnlySelf('likes'))
        && (!keys.hasAny(['going']) || togglesOnlySelf('going'))
        && (!keys.hasAny(['commentCount']) || commentCountDeltaOk());
    }

    // ── Flyers ────────────────────────────────────────────────────
    match /flyers/{flyerId} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isAuth()
        && (isOwner(resource.data.uploadedBy) || isMod() || isInteractionUpdate());
      allow delete: if isAuth() && (isOwner(resource.data.uploadedBy) || isMod());

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuth();
        allow delete: if isAuth() && (isOwner(resource.data.authorId) || isMod());
      }
    }

    // ── Posts ──────────────────────────────────────────────────────
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isAuth()
        && (isOwner(resource.data.uploadedBy) || isMod() || isInteractionUpdate());
      allow delete: if isAuth() && (isOwner(resource.data.uploadedBy) || isMod());

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuth();
        allow delete: if isAuth() && (isOwner(resource.data.authorId) || isMod());
      }
    }

    // ── Reports ───────────────────────────────────────────────────
    match /reports/{reportId} {
      allow read: if isAuth() && isMod();
      allow create: if isAuth();
      allow update: if isAuth() && isMod();
      allow delete: if isAuth() && isAdmin();
    }

    // ── Locations ─────────────────────────────────────────────────
    match /locations/{locationId} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isAuth();
    }
  }
}
